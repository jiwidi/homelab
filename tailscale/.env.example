# Copy to .env and fill in. .env is gitignored -- never commit it.
#   cp tailscale/.env.example tailscale/.env && chmod 600 tailscale/.env

# Auth key from https://login.tailscale.com/admin/settings/keys
# A reusable key survives container recreation; an ephemeral one does not.
# State lives in ./config (gitignored), so the key is only needed on first run.
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxx

# NOTE: subnet routes (192.168.31.0/24) and exit-node advertisement both require
# one-time manual approval in the admin console after the node first appears:
#   https://login.tailscale.com/admin/machines -> luna -> Edit route settings
