# Copy to .env and fill in. .env is gitignored -- never commit it.
#   echo "LLM_API_KEY=$(openssl rand -hex 24)" > unsloth/.env

# The server binds 0.0.0.0:8001 so LAN and VPN clients can reach it, so the
# launcher REFUSES TO START without this key. To run without one, bind locally:
#   HOST_BIND=127.0.0.1 ./qwen-server.sh
#
# One shared key, no per-user auth or rate limiting -- only hand it to people
# you'd give shell access to. Keep port 8001 off the public internet.
LLM_API_KEY=
