# Ignore config folders
# NOTE: matches a dir named `config` at ANY depth, which is what keeps the
# media stack's app state out of this PUBLIC repo -- arr/config/ holds
# gluetun's WireGuard key, the *arr config.xml API keys, and qBittorrent's
# credentials. Do not narrow this rule to a top-level path.
config/
bluemap-data/
backups/
priv/
cache/
# Ignore env files
.env
**/.env

# Ignore generated config files from templates
**/config.yaml
**/credentials.json

# Temporary files
.DS_Store
*.tmp
*.bak

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Specific folders
dockge/data/*
trash/
vert/vert-source/

# Open WebUI runtime data
ollama_openwebui/data/

# Unsloth model weights (multi-GB)
unsloth/models/

# oMLX — kept on disk and running, deliberately not tracked in this repo
omlx/

# Local Claude Code settings (machine-specific)
.claude/
