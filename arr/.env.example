# Copy to .env and fill in. .env is gitignored -- never commit it.
#   cp arr/.env.example arr/.env && chmod 600 arr/.env

# --- Mullvad WireGuard (gluetun) ---------------------------------------------
# From your Mullvad WireGuard .conf file.
#
# KEY AND ADDRESS ARE A MATCHED PAIR. The address is assigned by Mullvad per
# key; regenerating the key gets you a new address. Update BOTH together or the
# tunnel comes up silently and passes no traffic (WireGuard reports no error --
# the symptom is DNS timeouts in `docker logs gluetun`).
WIREGUARD_PRIVATE_KEY=        # [Interface] PrivateKey
# IPv4 ONLY. Mullvad configs list "10.x.x.x/32,fc00:.../128"; gluetun cannot
# parse the IPv6 half and fails to bring the interface up. Drop everything
# after the comma.
WIREGUARD_ADDRESSES=          # [Interface] Address, e.g. 10.64.0.2/32

# Exit location. Defaults to Stockholm if unset.
MULLVAD_CITY=Stockholm

# --- Storage ------------------------------------------------------------------
# Host path mounted as /data in every media container. Must contain BOTH
# torrents/ and media/ under one mount -- splitting them silently disables
# hardlinking and turns every import into a full byte copy. See README.md.
MEDIA_ROOT=/Users/<you>/Videos/library

# --- Container user / timezone ------------------------------------------------
# `id -u` and `id -g` on the host, so downloaded files are owned by you.
PUID=501
PGID=20
TZ=Europe/Madrid
